# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from your Supabase project.
#   Supabase Dashboard -> Project Settings -> Data API  (URL)
#   Supabase Dashboard -> Project Settings -> API Keys  (anon / publishable key)
#
# `.env` is gitignored. Never commit it.
#
# Anything prefixed EXPO_PUBLIC_ is compiled into the JavaScript bundle and can
# be extracted from a shipped app. That is expected for the two values below:
# the anon key is meant to be public, and Row Level Security — not key secrecy —
# is what keeps one user's data away from another.
#
# NEVER put the `service_role` key here, or anywhere in this repository. It
# bypasses Row Level Security entirely and would hand every user's data to
# anyone who unzips the app.
#
# The USDA FoodData Central key is deliberately absent: it is a real secret and
# lives only as a Supabase Edge Function secret. See supabase/README.md.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
